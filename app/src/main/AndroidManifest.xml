<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 전화 기능이 없는 기기(예: ChromeOS)에서도 설치 가능하도록 optional 처리 -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- SMS-based money management core feature. Play Console declaration required before production release. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- 알림 권한 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 인터넷 권한 (Claude API) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <!-- 금융 앱 알림 설정 화면에서 설치 여부를 확인할 앱 목록 -->
        <package android:name="com.kakaobank.channel" />        <!-- 카카오뱅크 -->
        <package android:name="com.kbcard.cxh.appcard" />       <!-- KB Pay -->
        <package android:name="com.kbstar.liivbank" />          <!-- Liiv -->
        <package android:name="com.kbstar.reboot" />            <!-- Liiv Next -->
        <package android:name="com.kbstar.kbbank" />            <!-- KB국민은행 스타뱅킹 -->
        <package android:name="com.lcacApp" />                  <!-- 롯데카드 -->
        <package android:name="com.wooricard.smartapp" />       <!-- 우리WON카드 -->
        <package android:name="com.wooribank.smart.npib" />     <!-- 우리WON뱅킹 -->
        <package android:name="nh.smart.nhallonepay" />         <!-- NH카드 -->
        <package android:name="kr.co.citibank.citimobile" />    <!-- 씨티카드 -->
        <package android:name="com.hyundaicard.appcard" />      <!-- 현대카드 -->
        <package android:name="kr.co.samsungcard.mpocket" />    <!-- 삼성카드 -->
        <package android:name="net.ib.android.smcard" />        <!-- 삼성 monimo -->
        <package android:name="com.hanaskcard.paycla" />        <!-- 하나카드 -->
        <package android:name="kr.co.hanamembers.hmscustomer" /><!-- 하나멤버스 -->
        <package android:name="com.shinhancard.smartshinhan" /> <!-- 신한카드 -->
        <package android:name="com.shcard.smartpay" />          <!-- 신한카드 -->
        <package android:name="com.shinhan.smartcaremgr" />     <!-- 신한카드 SOL -->
        <package android:name="com.ssg.serviceapp.android.egiftcertificate" /> <!-- 신세계페이 -->
        <package android:name="kvp.jjy.MispAndroid320" />       <!-- 비씨카드 -->
        <package android:name="viva.republica.toss" />          <!-- 토스 -->
        <package android:name="com.nhnent.payapp" />            <!-- 페이코 -->
        <package android:name="com.mysmilepay.app" />           <!-- 스마일페이 -->
        <package android:name="com.samsung.android.spay" />     <!-- 삼성페이 -->
        <package android:name="com.samsung.android.spaylite" /> <!-- 삼성페이 미니 -->
        <package android:name="com.sec.android.wallet" />       <!-- 삼성월렛 -->
        <package android:name="com.lge.lgpay" />                <!-- LG페이 -->
        <package android:name="com.lottemembers.android" />     <!-- L.POINT/L페이 -->
        <package android:name="kr.danal.app.damoum" />          <!-- 다날 결제 -->
        <package android:name="com.kftc.bankpay.android" />     <!-- 금융결제원/뱅크페이 -->
        <package android:name="com.nh.cashcardapp" />           <!-- 농협 앱캐시 -->
        <package android:name="kr.co.kfcc.mobilebank" />        <!-- MG새마을금고 -->
        <package android:name="com.knb.psb" />                  <!-- 경남은행 -->
        <package android:name="com.tmoney.inapp" />             <!-- 티머니 인앱결제 -->
        <package android:name="com.tmoney.nfc_pay" />           <!-- 티머니 NFC -->
        <package android:name="uplus.membership" />             <!-- LGU+ 휴대폰결제 -->
    </queries>

    <application
        android:name=".MoneyTalkApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoneyTalk"
        tools:targetApi="35">

        <!-- AdMob -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-4707673176609005~5012288836" />

        <!-- AdMob + Firebase Analytics AD_SERVICES_CONFIG 충돌 해결 -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />

        <!-- 인트로 (LAUNCHER) — 스플래시 + 권한 + RTDB + 강제 업데이트 -->
        <activity
            android:name=".feature.intro.ui.IntroActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MoneyTalk">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MoneyTalk" />

        <!-- 카테고리 상세 -->
        <activity
            android:name=".feature.categorydetail.ui.CategoryDetailActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MoneyTalk"
            android:windowSoftInputMode="adjustResize" />

        <!-- 거래 편집/추가 -->
        <activity
            android:name=".feature.transactionedit.ui.TransactionEditActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MoneyTalk"
            android:windowSoftInputMode="adjustResize" />

        <!-- 날짜별 거래 목록 -->
        <activity
            android:name=".feature.transactionlist.ui.TransactionDetailListActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MoneyTalk"
            android:windowSoftInputMode="adjustResize" />

        <!-- 문자 설정 -->
        <activity
            android:name=".feature.smssettings.ui.SmsSettingsActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MoneyTalk"
            android:windowSoftInputMode="adjustResize" />

        <!-- 카테고리 설정 -->
        <activity
            android:name=".feature.categorysettings.ui.CategorySettingsActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MoneyTalk"
            android:windowSoftInputMode="adjustResize" />

        <!-- 거래처 규칙 설정 -->
        <activity
            android:name=".feature.storerulesettings.ui.StoreRuleSettingsActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MoneyTalk"
            android:windowSoftInputMode="adjustResize" />

        <!-- SMS Receiver -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 메시지 앱 알림 기반 실시간 거래 감지 (RCS/비즈메시지 보완) -->
        <service
            android:name=".receiver.NotificationTransactionService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
